# 로컬 개발은 기본 SQLite 파일을 사용합니다. Turso를 사용할 때만 URL과 토큰을 변경하세요.
TURSO_DATABASE_URL=file:./data/app.db
TURSO_AUTH_TOKEN=
# 운영 환경에서는 32자 이상의 무작위 값으로 변경하세요.
BETTER_AUTH_SECRET=dev-only-change-me
# Stripe 결제를 사용하지 않으면 비워 두세요.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Canonical auth base URL (callbacks). Local dev only; on Vercel, VERCEL_URL is used when unset.
BETTER_AUTH_URL=http://localhost:3000
# 일반적인 로컬 개발과 Vercel 배포에서는 설정하지 않아도 됩니다.
# 휴대폰 등 다른 기기에서 LAN IP로 개발 서버에 접속할 때만 주석을 풀고 실제 주소를 입력하세요.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.0.10:3000,http://192.168.0.10:5173
VITE_BETTER_AUTH_URL=
