TURSO_DATABASE_URL=file:./data/app.db
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=dev-only-change-me
# Canonical auth base URL (callbacks). Port can differ from the browser in dev.
BETTER_AUTH_URL=http://localhost:3000
# Dev: any localhost / 127.0.0.1 port is auto-trusted. LAN IP needs an explicit entry:
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.0.10:3000,http://192.168.0.10:5173
VITE_BETTER_AUTH_URL=
