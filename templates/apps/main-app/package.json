{
  "name": "@{{projectName}}/main-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "mobile:build": "vite build --config vite.mobile.config.ts --mode mobile",
    "preview": "node .output/server/index.mjs",
    "cap:sync": "cap sync",
    "ios:dev": "vite --host 0.0.0.0 --port 3000 --mode ios",
    "android:dev": "vite --host 0.0.0.0 --port 3000 --mode android",
    "ios:build": "vite-capacitor build ios",
    "android:build": "vite-capacitor build android",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "better-auth generate --config ./server/auth.ts --output ./server/db/auth-schema.ts -y"
  },
  "dependencies": {
    "@capacitor/core": "catalog:",
    "@libsql/client": "catalog:",
    "better-auth": "catalog:",
    "@pinia/colada": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "class-variance-authority": "catalog:",
    "drizzle-orm": "catalog:",
    "h3": "catalog:",
    "nitro": "catalog:",
    "pinia": "catalog:",
    "reka-ui": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@capacitor/android": "catalog:",
    "@capacitor/cli": "catalog:",
    "@capacitor/ios": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-capacitor": "workspace:*",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
