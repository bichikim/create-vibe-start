{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bichikim/create-vibe-start/template-manifest.schema.json",
  "title": "Create Vibe Start Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
