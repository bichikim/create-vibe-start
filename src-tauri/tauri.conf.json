{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Start",
  "version": "0.1.3",
  "identifier": "com.vibestart.create",
  "build": {
    "beforeDevCommand": "pnpm desktop:web:dev",
    "beforeBuildCommand": "pnpm build && pnpm desktop:web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'; font-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Vibe Start",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "../dist/desktop-worker": "desktop-worker",
      "../dist/templates": "templates",
      "../dist/.agents": ".agents",
      "../dist/oxlint.config.ts": "oxlint.config.ts",
      "../dist/.oxfmtrc.json": ".oxfmtrc.json",
      "runtime": "runtime",
      "../desktop/toolchain.json": "toolchain.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/bichikim/create-vibe-start/releases/latest/download/latest.json"
      ]
    }
  }
}
