{
  "name": "create-vibe-start",
  "version": "0.1.2-alpha.1",
  "description": "Interactive CLI onboarding for preparing GitHub, Vercel, and Codex accounts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bichikim/create-vibe-start.git"
  },
  "bin": {
    "create-vibe-start": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "vite build",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "reset:environment": "tsx src/cli.ts reset",
    "start": "node dist/cli.js",
    "version:alpha": "pnpm version prerelease --preid=alpha --no-git-tag-version",
    "version:latest": "pnpm version patch --no-git-tag-version",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "node-plop": "^0.32.3",
    "ora": "^9.0.0",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "eslint-plugin-sort-export-all": "^2.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-plugin-eslint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.10",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2"
}
