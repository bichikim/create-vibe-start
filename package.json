{
  "name": "create-vibe-start",
  "version": "0.1.0",
  "description": "Interactive CLI onboarding for preparing GitHub, Vercel, and Codex accounts.",
  "bin": {
    "create-vibe-start": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "reset:dev-tools": "tsx scripts/reset-dev-tools.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "ora": "^9.0.0",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "eslint-plugin-sort-export-all": "^2.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-plugin-eslint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
